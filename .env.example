# Public client configuration. These values are visible in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Leaflet tile URLs. When empty, Near Me uses OpenStreetMap. No map API key is required.
NEXT_PUBLIC_MAP_TILE_LIGHT=
NEXT_PUBLIC_MAP_TILE_DARK=

# Server-only. Used by scripts/migrate.mjs. Never prefix with NEXT_PUBLIC_.
# The direct db host is often IPv6-only. Use the session pooler if it does not resolve.
SUPABASE_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
SUPABASE_DB_USER=postgres.yourprojectref
SUPABASE_DB_PORT=5432
SUPABASE_DB_PASSWORD=

# Optional. When set, meeting suggestions can include a short written reason.
# Places still come from OpenStreetMap. The model cannot invent locations.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
